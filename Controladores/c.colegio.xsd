<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
 <!-- Restricciones -->
    <xs:simpleType name="EXPType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{1}[0-9]{3}"/>
        </xs:restriction> 
    </xs:simpleType>
    <xs:simpleType name="CIDPType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-z]{1}[0-9]{3}"/>
        </xs:restriction> 
    </xs:simpleType>
    <xs:simpleType name="NIDAType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{3}[0-9]{3}"/>
        </xs:restriction> 
    </xs:simpleType>
    <xs:simpleType name="cursoType">
        <xs:restriction base="xs:string">
            <xs:pattern value="ESO [1-4][º][A-D]"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="cursosType">
        <xs:restriction base="xs:string">
            <xs:pattern value="(1ºESO|2ºESO|3ºESO|4ºESO)(, (1ºESO|2ºESO|3ºESO|4ºESO))*"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="departamentoType">
        <xs:restriction base="xs:string">
            <xs:pattern value="Informática|Filosofía|Lengua|Matemática"/>
        </xs:restriction>
    </xs:simpleType>
 <!-- Elemento Raíz -->
   <xs:element name="colegio">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="alumnos" maxOccurs="unbounded">
                    <xs:complexType>
                      <xs:sequence>
                        <xs:element name="alumno" maxOccurs="unbounded">
                         <xs:complexType>
                          <xs:sequence>
                            <xs:element name="nombre" type="xs:string"/>
                            <xs:element name="apellido1" type="xs:string"/>
                            <xs:element name="apellido2" type="xs:string"/>
                            <xs:element name="edad" type="xs:string"/>
                            <xs:element name="curso" type="cursoType"/>
                            <xs:element name="N.contacto" type="xs:string"/>
                          </xs:sequence>
                          <xs:attribute name="EXP" type="EXPType" use="required"/>
                         </xs:complexType>
                        </xs:element>
                      </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="profesores">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="profesor" maxOccurs="unbounded">
                                <xs:complexType>
                                  <xs:sequence>
                                    <xs:element name="nombre" type="xs:string"/>
                                    <xs:element name="apellido1" type="xs:string"/>
                                    <xs:element name="apellido2" type="xs:string"/>
                                    <xs:element name="Departamento" type="departamentoType"/>
                                    <xs:element name="N.contacto" type="xs:string"/>
                                    <xs:element name="Email" type="xs:string"/>
                                  </xs:sequence>
                                  <xs:attribute name="CIDP" type="CIDPType" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="asignaturas">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="asignatura" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="nombre" type="xs:string"/>
                                        <xs:element name="cursos" type="cursosType"/>
                                        <xs:element name="libros">
                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="libro" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:sequence>
                                                                <xs:element name="nombre" type="xs:string"/>
                                                                <xs:element name="editorial" type="xs:string"/>
                                                            </xs:sequence>
                                                            
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:sequence>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:sequence>
                                    <xs:attribute name="NIDA" type="NIDAType" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
   </xs:element>

    


</xs:schema>